#!/bin/bash
# Set up this Mac from the dotfiles repo. Safe to re-run: each step skips what's
# already done, and Stow is dry-run first so nothing is overwritten.
#
#   ./install            everything
#   ./install --no-brew  skip Homebrew and the Brewfile (just link and configure)
set -euo pipefail

REPO=$(cd "$(dirname "$0")" && pwd)
cd "$REPO"

# Top-level folders that aren't Stow packages.
NOT_PACKAGES=" brew test "

# Folders that must exist as real directories before stowing, because other
# tools keep untracked files in them. Without these Stow would symlink the
# whole folder into the repo, and those tools' state would land in git.
REAL_DIRS=(
    "$HOME/.config"
    "$HOME/.config/atuin"
    "$HOME/.config/gh"
    "$HOME/.config/mycli"
    "$HOME/.config/omniwm"
    "$HOME/.local/bin"
    "$HOME/.local/lib"
    "$HOME/.claude"
    "$HOME/.claude/skills"
    "$HOME/.ssh"
)

brew=1
for arg in "$@"; do
    case $arg in
        --no-brew) brew=0 ;;
        -h | --help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; exit 2 ;;
    esac
done

step() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mError:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(uname -s)" = Darwin ] || die "these dotfiles are for macOS"

if [ "$brew" = 1 ]; then
    step "Xcode Command Line Tools"
    if ! xcode-select -p >/dev/null 2>&1; then
        xcode-select --install || true
        die "finish the Command Line Tools install in the dialog, then re-run ./install"
    fi
    echo "Installed."

    step "Homebrew"
    if [ ! -x /opt/homebrew/bin/brew ]; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    eval "$(/opt/homebrew/bin/brew shellenv)"
    echo "Installed."

    step "Brewfile"
    # Carry on if some formulae fail (e.g. a private tap before you've signed
    # in to GitHub): linking only needs stow.
    brew bundle --file brew/Brewfile ||
        warn "brew bundle didn't finish; fix the errors above and re-run ./install"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

command -v stow >/dev/null || die "stow isn't installed (brew install stow)"

step "Directories"
for dir in "${REAL_DIRS[@]}"; do
    if [ -L "$dir" ]; then
        warn "$dir is a symlink; Stow may have folded it. Remove it and re-run."
    else
        mkdir -p "$dir"
    fi
done
chmod 700 "$HOME/.ssh"
echo "${#REAL_DIRS[@]} folders in place."

step "Linking"
packages=()
for dir in */; do
    pkg=${dir%/}
    case $NOT_PACKAGES in *" $pkg "*) continue ;; esac
    packages+=("$pkg")
done
echo "${packages[*]}"

# Dry run first: Stow reports any existing file in the way and changes nothing.
if ! conflicts=$(stow --no --restow "${packages[@]}" 2>&1); then
    echo "$conflicts" >&2
    die "files are in the way of the links above. Move or delete them (or merge
       them into the repo), then re-run. 'stow --adopt <pkg>' pulls an existing
       file into the repo; check 'git diff' afterwards."
fi
stow --restow "${packages[@]}"
echo "Linked."

step "macOS preferences"
./macos.sh
echo "Applied."

if command -v mise >/dev/null; then
    step "mise runtimes"
    mise install
fi

step "Done. Manual steps, if this is a new machine:"
cat <<'EOF'
  - Sign in to 1Password and enable its SSH agent (Git commit signing uses it)
  - gh auth login
  - atuin login   (or atuin register)
  - Add ~/.config/zsh/*.local.zsh for machine-specific environment and secrets
  - Add ~/.ssh/config.d/* for private hosts
  - Open a new shell
EOF
