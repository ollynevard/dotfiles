[include]
  path = delta/catppuccin.gitconfig

[user]
  name = Olly Nevard
  email = 150187+ollynevard@users.noreply.github.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJZE79brG6DVMCuZ5+e5N+1QzkJ+53LUu4KZko4M1pCr

[core]
  excludesFile = ~/.config/git/ignore
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  light = false
  features = catppuccin-mocha

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[gpg]
  format = ssh

[alias]
  a = "add"
  b = "branch"
  c = "commit"
  cf = "config"
  co = "checkout"
  cl = "clone"
  cp = "cherry-pick"
  d = "diff"
  delete-squashed = "!f() { local targetBranch=${1:-main} && git checkout -q $targetBranch && git branch --merged | grep -v \"\\*\" | xargs -n 1 git branch -d && git for-each-ref refs/heads/ \"--format=%(refname:short)\" | while read branch; do mergeBase=$(git merge-base $targetBranch $branch) && [[ $(git cherry $targetBranch $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == \"-\"* ]] && git branch -D $branch; done; }; f"
  dft = "-c diff.external=difft diff"
  dlog = "-c diff.external=difft log -p --ext-diff"
  ds = "delete-squashed"
  f = "fetch"
  l = "log"
  m = "merge"
  p = "push"
  pl = "pull"
  r = "rebase"
  rs = "reset"
  s = "status"
  sm = "submodule"
  st = "stash"
  t = "tag"

[pull]
  rebase = true

[push]
  default = current

[init]
  defaultBranch = main

[includeIf "hasconfig:remote.*.url:git@github.com:ambassador-cruise-line/**"]
  path = work.gitconfig

[url "git@github.com:ambassador-cruise-line/"]
  insteadOf = amb://
  insteadOf = ambassador://

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
