# _prompt_context: set the variables behind the folder, ticket and PR pills
# (env_var.STARSHIP_* in starship.toml). Exported for the same reason as
# _prompt_aws's.
#
# - Folder: in a git repository, the project's name and where you are inside it
#   (~/Code/wave/.bare and ~/Code/wave/.git are both "wave"), since a
#   worktree's folder repeats its branch. Elsewhere, the last three folders.
# - Ticket: the ABC-123 at the start of any part of the branch name, when git
#   config prompt.ticketUrl lists its prefix: "URL-with-{} PREFIX…", one line
#   per tracker (set in git/.config/git/work.gitconfig). Its colour follows the
#   PR: yellow in progress (no PR, a draft or a closed one), teal in review (an
#   open PR), green done (merged).
# - PR: the branch's pull request, from gh, coloured by review state: green
#   (approved, or no review needed), peach (waiting for review), red (changes
#   requested), grey (draft or closed), mauve (merged). Its checks are fused
#   on: a heat map of ■, one per check in CI order (green passed, yellow
#   running, red failed; skipped ones left out) until they've all passed, then
#   ✓ and how many. Over 24 checks, just how many failed or how far along. Cached per branch and fetched in the
#   background when the copy is over 2 minutes old (30 seconds while checks
#   run); the prompt redraws when it
#   arrives (_prompt_pr_done in _prompt_setup). The Claude Code status line
#   (claude/.claude/statusline) calls this too.
#
# Ticket and PR are links. Starship mangles the escape codes for a link, so the
# pills get a placeholder (⟦1⟧, ⟦2⟧) and _prompt_decorate swaps in the link from
# _prompt_links: placeholder, text, URL, …
unset STARSHIP_FOLDER STARSHIP_TICKET STARSHIP_TICKET_REVIEW STARSHIP_TICKET_DONE \
  STARSHIP_PR STARSHIP_PR_PENDING STARSHIP_PR_CHANGES STARSHIP_PR_DRAFT STARSHIP_PR_MERGED \
  STARSHIP_CHECKS
_prompt_links=() _prompt_checks=()
local lock=; [[ -w $PWD ]] || lock=' 󰌾'

local -a info
info=("${(@f)$(git rev-parse --path-format=absolute --git-common-dir --show-toplevel --show-prefix 2>/dev/null)}")
if (( $#info < 2 )); then
  local dir=${(D)PWD}
  local -a parts=(${(s:/:)dir})
  (( $#parts > 3 )) && dir=…/${(j:/:)parts[-3,-1]}
  export STARSHIP_FOLDER=' '$dir$lock
  return 0
fi
local common=${info[1]} top=${info[2]} sub=${info[3]%/}
local name=${top:t}
[[ ${common:t} == (.git|.bare) ]] && name=${common:h:t}
local -a parts=(${(s:/:)sub})
(( $#parts > 2 )) && sub="…/${(j:/:)parts[-2,-1]}"
export STARSHIP_FOLDER=' '$name${sub:+/$sub}$lock

local branch
branch=$(git symbolic-ref -q --short HEAD) || return 0

# Ticket (its pill is set after the PR's, whose state it follows)
local key line ticket=
if [[ /$branch =~ '/([A-Za-z][A-Za-z0-9]*)-([0-9]+)' ]]; then
  key=${(U)match[1]}-${match[2]}
  for line in ${(f)"$(git config --get-all prompt.ticketurl)"}; do
    local -a w=(${=line})
    if (( ${w[2,-1][(Ie)${key%-*}]} )); then
      ticket=1
      _prompt_links+=(⟦1⟧ $key ${w[1]//\{\}/$key})
      break
    fi
  done
fi

# PR: the cache holds "number url state checks", or nothing when the branch
# has none. state: merged, closed, draft, approved, changes_requested,
# review_required, or open. checks: a letter per check in CI order (p passed,
# r running, f failed), or - when there are none. Then a line per check with
# its page, in the same order.
local cache=${XDG_CACHE_HOME:-$HOME/.cache}/prompt-pr/${${common:h}//\//%}@${branch//\//%}
local pr
local -a p fresh
local -a urls
if [[ -r $cache ]]; then
  urls=("${(@f)$(<$cache)}")
  pr=$urls[1] p=(${=urls[1]}) urls=($urls[2,-1])
fi
if [[ $p[4] == *r* ]]; then fresh=($cache(N.ms-30)); else fresh=($cache(N.mm-2)); fi
if (( ! $#fresh && ! _prompt_pr_fd )) && (( $+commands[gh] )); then
  mkdir -p ${cache:h}
  _prompt_pr_fetch() {
    cd -q $top && gh pr view --json number,url,state,isDraft,reviewDecision,statusCheckRollup -q '
      def check: if .__typename == "StatusContext"
        then {SUCCESS: "p", FAILURE: "f", ERROR: "f"}[.state] // "r"
        elif .status != "COMPLETED" then "r"
        else {SUCCESS: "p", NEUTRAL: "p", SKIPPED: "", STALE: ""}[.conclusion] // "f" end;
      [.statusCheckRollup[]? | {l: check, u: (.detailsUrl // .targetUrl // "")} | select(.l != "")] as $c |
      "\(.number) \(.url) \(if .state != "OPEN" then .state | ascii_downcase
        elif .isDraft then "draft" else .reviewDecision // "open" | ascii_downcase end) \(
        $c | map(.l) | join("") | if . == "" then "-" else . end)", ($c[] | .u)' >$cache.$$ 2>/dev/null
    mv -f $cache.$$ $cache
  }
  if [[ -o zle ]]; then
    exec {_prompt_pr_fd}< <(_prompt_pr_fetch)
    zle -F $_prompt_pr_fd _prompt_pr_done
  else # not a shell (the Claude Code status line): the next run picks it up
    _prompt_pr_fetch &>/dev/null &!
  fi
fi
if [[ -n $pr ]]; then
  case $p[3] in
    merged) export STARSHIP_PR_MERGED=⟦2⟧ ;;
    draft|closed) export STARSHIP_PR_DRAFT=⟦2⟧ ;;
    changes_requested) export STARSHIP_PR_CHANGES=⟦2⟧ ;;
    review_required) export STARSHIP_PR_PENDING=⟦2⟧ ;;
    *) export STARSHIP_PR=⟦2⟧ ;;
  esac
  _prompt_links+=(⟦2⟧ \#$p[1] $p[2])
  # Checks: (colour text link) for _prompt_decorate to swap in for ⟦3⟧. Each
  # cell links to its check; a count to the PR's checks tab.
  local checks=${p[4]#-} all=$p[2]/checks
  local -i n
  if [[ -n $checks ]]; then
    export STARSHIP_CHECKS=⟦3⟧
    local -i fails=${#checks//[^f]} done=${#checks//[^pf]}
    if [[ $checks != *[rf]* ]]; then _prompt_checks=(green " $#checks" $all)
    elif (( $#checks <= 24 )); then
      local -A colour=(p green r yellow f red)
      for (( n = 1; n <= $#checks; n++ )); do
        _prompt_checks+=($colour[$checks[n]] ■ ${urls[n]:-$all})
      done
    elif (( fails )); then _prompt_checks=(red " $fails" $all)
    else _prompt_checks=(yellow "󰔟 $done/$#checks" $all)
    fi
  fi
fi
if [[ -n $ticket ]]; then
  if [[ -z $pr || $p[3] == (draft|closed) ]]; then export STARSHIP_TICKET=⟦1⟧
  elif [[ $p[3] == merged ]]; then export STARSHIP_TICKET_DONE=⟦1⟧
  else export STARSHIP_TICKET_REVIEW=⟦1⟧
  fi
fi
return 0
