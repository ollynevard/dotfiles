# _prompt_render: render the prompt once, add links and fuse touching pills into
# a ribbon (_prompt_decorate), and work out the collapsed version: the full
# prompt minus its context line, which is third from last ([… rule, context,
# blank, ❯]). That position comes from the format in starship.toml: keep the
# two in step.
_prompt_text=${(e)_prompt_template}
(( _prompt_skip_blank )) && _prompt_text=${_prompt_text#$'\n'}
_prompt_decorate $_prompt_text
_prompt_text=$REPLY
local -a lines=("${(@f)_prompt_text}")
lines[-3]=()
_prompt_short=${(pj:\n:)lines}
